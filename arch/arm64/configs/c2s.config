# Config file for c2s (Galaxy Note20 Ultra 5G)
# This is merged with exynos990_defconfig on build

CONFIG_MODEL_C2S=y

CONFIG_RBIN=y

CONFIG_SAMSUNG_NFC=y
CONFIG_SEC_NFC=y
CONFIG_SEC_NFC_LOGGER=y

CONFIG_USB_NET_AQC111=y
CONFIG_BCM4375=m

# Camera
CONFIG_CAMERA_EEPROM_SUPPORT_REAR=y
CONFIG_CAMERA_EEPROM_SUPPORT_FRONT=y
CONFIG_OIS_USE=y
CONFIG_AF_HOST_CONTROL=y
CONFIG_CAMERA_USE_INTERNAL_MCU=y
CONFIG_CAMERA_CIS_TOF_BUCK_USE=y
CONFIG_CAMERA_LASER_AF_VL53L5_OBJ=m
CONFIG_CAMERA_ACT_AK737X_OBJ=m
CONFIG_CAMERA_PP_GDC_V3_1_0_OBJ=m
CONFIG_CAMERA_CIS_3J1_OBJ=m
CONFIG_CAMERA_CIS_3M5_OBJ=m
CONFIG_CAMERA_CIS_2L3_OBJ=m
CONFIG_CAMERA_CIS_HM1_OBJ=m
CONFIG_CAMERA_CIS_IMX518_OBJ=m
CONFIG_CAMERA_FLASH_S2MPB02_OBJ=m

# Display: S6E3HAC
CONFIG_EXYNOS_DECON_LCD_COPR=y
CONFIG_SUPPORT_HMD=y
CONFIG_EXTEND_LIVE_CLOCK=y
CONFIG_SUPPORT_DISPLAY_PROFILER=y
CONFIG_SUPPORT_DDI_FLASH=y
CONFIG_SUPPORT_MAFPC=y
CONFIG_SUPPORT_POC_SPI=y
# CONFIG_EXYNOS_DECON_LCD_S6E3HAB is not set
# CONFIG_EXYNOS_DECON_LCD_S6E3FAB is not set
# CONFIG_EXYNOS_DECON_LCD_S6E3FC3 is not set
# CONFIG_EXYNOS_DECON_LCD_S6E3HAD is not set
# CONFIG_EXYNOS_DECON_LCD_EA8082 is not set
# CONFIG_EXYNOS_DECON_LCD_S6E3FA9 is not set
CONFIG_EXYNOS_DECON_LCD_S6E3HAC=y

CONFIG_LEDS_S2MPB02=m

# Sensor hub (SSP)
CONFIG_SENSORS=y
CONFIG_SENSORS_SSP=y
CONFIG_SENSORS_SSP_BBD=y
CONFIG_SENSORS_SSP_SENSORHUB=y
CONFIG_SENSORS_SSP_MOBEAM=y
CONFIG_SENSORS_SSP_LIGHT_REPORT_LUX=y
CONFIG_SENSORS_SSP_LIGHT_ADDING_LUMINANCE=y
CONFIG_SENSORS_SSP_LIGHT_MAX_ATIME_2BYTE=y
CONFIG_SENSORS_SSP_LIGHT_MAX_GAIN_2BYTE=y
CONFIG_SENSORS_SSP_IRDATA_FOR_CAMERA=y
CONFIG_SENSORS_SSP_LIGHT_LUX_RAW=y
CONFIG_SENSORS_SSP_PROX_LIGHT_DIFF=y
CONFIG_SENSORS_SSP_THERMISTOR=y
CONFIG_SENSORS_DYNAMIC_SENSORLIST=y
CONFIG_SENSORS_SSP_CANVAS=y
CONFIG_SENSORS_SSP_INTERRUPT_GYRO_SENSOR=y
CONFIG_SENSORS_SSP_HIFI_BATCHING=y
CONFIG_SENSORS_SX9360=y
CONFIG_SENSORS_A96T3X6=y
CONFIG_SENSORS_A96T365IF=y
CONFIG_SENSORS_A96T3X6_CRC_CHECK=y
CONFIG_SENSORS_A96T3X6_BLOCK_SAR_ONLY=y
CONFIG_SENSORS_QBT2000=y
CONFIG_SENSORS_TCS3407=y
CONFIG_SENSORS_VL53L5=y
CONFIG_SENSORS_VL53L5_C2=y
CONFIG_SENSORS_VL53L5_SUPPORT_UAPI=y
CONFIG_SENSORS_VL53L5_SUPPORT_KERNEL_INTERFACE=y

# Haptics
CONFIG_MOTOR_CS40L2X=m
# CONFIG_MOTOR_DRV_MAX77705 is not set  # driver not ported yet

# Charging / PMIC
CONFIG_MFD_S2MPB02=m
CONFIG_REGULATOR_S2MPB02=m
CONFIG_REGULATOR_S2DOS05=m
CONFIG_CHARGER_PCA9468=m
CONFIG_PD_CHARGER_HV_DISABLE=y
# CONFIG_WIRELESS_CHARGER_MFC_S2MIW04 is not set  # 5.4 uses generic MFC
# CONFIG_WIRELESS_CHARGER_HAL_MFC is not set
CONFIG_WIRELESS_CHARGER_MFC=y

# Touch
CONFIG_INPUT_TOUCHSCREEN_TCLMV2=y
CONFIG_TOUCHSCREEN_SEC_TS=y
CONFIG_TOUCHSCREEN_SEC_TS_GLOVEMODE=y
CONFIG_SEC_DEBUG_TSP_LOG=y
CONFIG_TOUCHSCREEN_DUMP_MODE=y

CONFIG_INPUT_HALL_IC=y
CONFIG_HALL_NOTIFIER=y

CONFIG_UFS_SRPMB=y

# Modem: Exynos 990 uses the S5100 CP
CONFIG_SEC_MODEM_S5100=m
